# 把这个文件复制一份改名为 .env，填上 key 后重启 python app.py。

# ---- 即梦（火山方舟 Seedream），只填这一个就能用：https://console.volcengine.com/ark
#      「API Key 管理」创建 key，「开通管理」里开通 Doubao-Seedream-4.5
ARK_API_KEY=

# ---- 以下可选，用来对比效果
# ---- 阿里云百炼：https://bailian.console.aliyun.com 创建 API Key，并开通「AI试衣-Plus」「AI试衣-图片精修」「通义千问图像编辑」
DASHSCOPE_API_KEY=

# ---- 可灵：https://app.klingai.com/cn/dev 开放平台创建 AccessKey / SecretKey，并购买「虚拟试穿」资源包
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ---- fal.ai（可选，原方案对照用）
FAL_KEY=

# 以下都可以不填，用默认值。
# PIPELINE=seedream           # 换衣服用哪条流程：seedream / bailian / kling / fal（默认：第一个填了 key 的）
# EDIT_PROVIDER=seedream      # 生成形象照、换鞋、调整穿法、戴配饰用哪家的编辑模型：seedream / bailian / fal
# SEEDREAM_MODEL=doubao-seedream-4-5-251128   # 也可以试 doubao-seedream-5-0-260128
# BL_TRYON_MODEL=aitryon-plus # 便宜一些可以改成 aitryon
# BL_EDIT_MODEL=qwen-image-edit-plus
# GENDER=woman               # 你的性别：woman / man，用于精修模型和提示词
# KLING_BASE_URL=https://api-beijing.klingai.com
# KLING_TRYON_MODEL=kolors-virtual-try-on-v1-5

# 界面估价（人民币/次），按控制台实际价格改
# PRICE_EDIT_SEEDREAM=0.25    # 估计值，请按控制台价格改
# PRICE_TRYON_BAILIAN=0.5     # aitryon-plus 官方标价 0.5 元/张
# PRICE_REFINE_BAILIAN=0.5
# PRICE_EDIT_BAILIAN=0.3
# PRICE_TRYON_KLING=0.5
