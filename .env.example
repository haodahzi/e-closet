# 把这个文件复制一份改名为 .env，填上 key 后重启。
# key 在 https://fal.ai/dashboard/keys 创建。
FAL_KEY=

# 以下都可以不填，用默认值。
# EDIT_MODEL=fal-ai/nano-banana-pro/edit              # 整套换装 + 配饰用的多图编辑模型
# VTON_MODEL=fal-ai/kling/v1-5/kolors-virtual-try-on  # “加强衬衫细节”用的专用试穿模型
# RESOLUTION=1K                                        # 1K / 2K / 4K（4K 价格翻倍）
# EDIT_PRICE=0.15                                      # 仅用于界面估价，单位美元/张
# VTON_PRICE=0.07
